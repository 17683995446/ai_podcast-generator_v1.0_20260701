# ============================================================
# GitHub 播客生成工具 - 环境变量配置
# 复制为 .env 并填入你的 API Key
# ============================================================

# --- DeepSeek API（脚本生成，OpenAI 兼容）---
# 申请：https://platform.deepseek.com
# 新用户 $5 免费额度，模型 deepseek-chat (V4-Flash)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- 阿里云百炼 API（CosyVoice TTS）---
# 申请：https://bailian.console.aliyun.com
# 新用户赠送额度，模型 cosyvoice-v3-flash
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# --- GitHub Token（可选，提升 API 限流至 5000/h）---
# 申请：https://github.com/settings/tokens (只需 public_repo 读取)
GITHUB_TOKEN=ghp_your-github-token-here

# --- 播客元信息 ---
PODCAST_TITLE=GitHub 前沿观察
PODCAST_AUTHOR=Your Name
PODCAST_EMAIL=you@example.com
PODCAST_SITE_URL=https://your-site.example.com
# 音频文件公开访问基础 URL（用于 RSS feed 中的 enclosure）
PODCAST_MEDIA_BASE_URL=https://your-site.example.com/episodes
